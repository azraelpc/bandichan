<Window x:Class="Bandichan.App.ExportCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Complete"
        Icon="pack://application:,,,/Assets/bandichan.ico"
        Height="190"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="The video export completed successfully." FontWeight="SemiBold" />
        <TextBlock x:Name="ResultText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="180" IsDefault="True" Click="OpenFolderClick">Open Output Folder</Button>
        </StackPanel>
    </Grid>
</Window>
