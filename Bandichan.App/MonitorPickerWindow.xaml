<Window x:Class="Bandichan.App.MonitorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose monitor"
        Icon="pack://application:,,,/Assets/bandichan.ico"
    Height="260"
    Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Multiple monitors detected. Select where to record."
            Margin="0,0,0,10"
            FontWeight="SemiBold" />

        <ListBox
            x:Name="MonitorsList"
            Grid.Row="1"
            Margin="0,0,0,14"
            MouseDoubleClick="MonitorsListMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="96" Margin="0,0,8,0" Click="CancelClick">Cancel</Button>
            <Button Width="96" IsDefault="True" Click="ConfirmClick">Record</Button>
        </StackPanel>
    </Grid>
</Window>
